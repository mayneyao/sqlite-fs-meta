/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/cli/latest.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  Link: </llms.txt>; rel="describedby"

/docs/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache
  Link: </llms.txt>; rel="describedby"
