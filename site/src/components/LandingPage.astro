---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from './SiteNav.astro';
import ProductDemo from './ProductDemo.astro';
import InstallCommand from './InstallCommand.astro';
import Footer from './Footer.astro';
import { messages, type Locale } from '../data/i18n';
import { docs } from '../data/project';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = messages[locale];
---
<BaseLayout locale={locale}>
  <SiteNav locale={locale} />
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-heading">
        <p class="hero-eyebrow label">{t.hero.eyebrow}</p>
        <h1 id="hero-title">{t.hero.title[0]}<br /><span>{t.hero.title[1]}</span></h1>
        <p class="hero-description">{t.hero.description[0]}<code>xmeta</code>{t.hero.description[1]}</p>
        <div class="hero-actions">
          <a class="button" href="#install">{t.hero.install}</a>
          <a class="button button-secondary" href={`${docs}/cli.md`}>{t.hero.docs} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <InstallCommand locale={locale} />
      <div class="hero-demo"><ProductDemo locale={locale} /></div>
    </section>
    <section class="section container model" id="model" aria-labelledby="model-title">
      <div>
        <p class="label section-label">{t.model.label}</p>
        <h2 id="model-title">{t.model.title[0]}<br />{t.model.title[1]}</h2>
        <p class="section-description">{t.model.description}</p>
      </div>
      <dl class="model-details">{t.model.details.map((detail) => <div><dt>{detail.title}</dt><dd>{detail.text}</dd></div>)}</dl>
    </section>
    <section class="section container gui" aria-labelledby="gui-title">
      <div>
        <p class="label section-label">{t.gui.label}</p>
        <h2 id="gui-title">{t.gui.title}</h2>
      </div>
      <div class="gui-details">
        <p class="section-description">{t.gui.description} <code>space.eidos.meta</code>{t.gui.detail}</p>
        <a class="text-link" href={t.gui.href}>{t.gui.action} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .hero { padding-block: clamp(3rem, 6vw, 5rem) 4rem; }
  .hero-heading { max-width: 900px; margin-inline: auto; text-align: center; }
  .hero-eyebrow { color: var(--accent); letter-spacing: 0.22em; }
  h1 { margin-top: 1.25rem; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.08; letter-spacing: -0.035em; }
  h1 span { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.14em; }
  h1:lang(zh-CN) { font-size: clamp(1.5rem, 7.8vw, 3.5rem); line-height: 1.25; letter-spacing: -0.015em; }
  .hero-description { max-width: 660px; margin: 1.5rem auto 0; color: var(--muted); font-size: 1.125rem; line-height: 1.7; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero-demo { margin-top: 3rem; }
  .section { padding-block: clamp(4rem, 7vw, 6rem); border-top: 1px solid var(--rule); }
  .section-label { color: var(--accent); margin-bottom: 1rem; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; }
  h2:lang(zh-CN) { font-size: clamp(1.9rem, 3.6vw, 2.75rem); line-height: 1.4; letter-spacing: -0.015em; }
  .section-description { max-width: 46ch; color: var(--muted); font-size: 1.0625rem; line-height: 1.8; }
  .model { display: grid; gap: 2.5rem; }
  .model .section-description { margin-top: 1.5rem; }
  .model-details > div { padding-block: 1.5rem; border-bottom: 1px solid var(--rule); }
  .model-details > div:first-child { padding-top: 0; }
  .model-details dt { font-size: 1.0625rem; font-weight: 500; }
  .model-details dd { margin-top: 0.5rem; max-width: 54ch; color: var(--muted); font-size: 0.9375rem; line-height: 1.8; }
  .gui { display: grid; gap: 1.5rem; padding-block: clamp(3rem, 5vw, 4rem); }
  .gui h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .gui code { overflow-wrap: anywhere; }
  .gui .text-link { margin-top: 1rem; }
  @media (min-width: 880px) { .model, .gui { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5rem; } }
  @media (max-width: 560px) { .hero-description { font-size: 1rem; } .hero-demo { margin-top: 2rem; } }
</style>
