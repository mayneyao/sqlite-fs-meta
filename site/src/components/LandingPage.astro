---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from './SiteNav.astro';
import ProductDemo from './ProductDemo.astro';
import InstallCommand from './InstallCommand.astro';
import CodeBlock from './CodeBlock.astro';
import Footer from './Footer.astro';
import AgentPrompt from './AgentPrompt.astro';
import { messages, type Locale } from '../data/i18n';
import { docs } from '../data/project';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = messages[locale];
const extension = `.load ./libfs_meta

CREATE VIRTUAL TABLE files USING fs_meta(
  root = './notes'
);

SELECT id, rating FROM files
WHERE is_dir = 0 AND rating >= 4;`;
const cli = `xmeta set notes/note.md status=Active rating:=5

xmeta schema set ./notes "rating INTEGER, status TEXT"

xmeta query ./notes \\
  "SELECT id, rating FROM files WHERE rating >= 4"`;
---
<BaseLayout locale={locale}>
  <SiteNav locale={locale} />
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-heading">
        <p class="hero-eyebrow label">{t.hero.eyebrow}</p>
        <h1 id="hero-title">{t.hero.title[0]}<br /><span>{t.hero.title[1]}</span></h1>
        <p class="hero-description">{t.hero.description[0]}<code>xmeta</code>{t.hero.description[1]}</p>
        <div class="hero-actions">
          <a class="button" href="#install">{t.hero.install}</a>
          <a class="button button-secondary" href={`${docs}/cli.md`}>{t.hero.docs} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#agents">{t.agent.action} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <InstallCommand locale={locale} />
      <div class="hero-demo"><ProductDemo locale={locale} /></div>
    </section>
    <section class="section container model" id="model" aria-labelledby="model-title">
      <div>
        <p class="label section-label">{t.model.label}</p>
        <h2 id="model-title">{t.model.title[0]}<br />{t.model.title[1]}</h2>
        <p class="section-description">{t.model.description}</p>
      </div>
      <dl class="model-details">{t.model.details.map((detail) => <div><dt>{detail.title}</dt><dd>{detail.text}</dd></div>)}</dl>
    </section>
    <section class="section container interfaces" id="interfaces" aria-labelledby="interfaces-title">
      <div class="section-heading">
        <p class="label section-label">{t.interfaces.label}</p>
        <h2 id="interfaces-title">{t.interfaces.title[0]}<br />{t.interfaces.title[1]}</h2>
        <p class="section-description">{t.interfaces.description[0]}<code>xmeta</code>{t.interfaces.description[1]}</p>
      </div>
      <div class="interface-grid">
        <article>
          <div class="interface-heading"><h3>{t.interfaces.cli}</h3><span class="label muted">{t.interfaces.edit}</span></div>
          <CodeBlock locale={locale} code={cli} label={t.interfaces.shell} />
          <a class="text-link" href={`${docs}/cli.md`}>{t.interfaces.cliDocs} <span aria-hidden="true">↗</span></a>
        </article>
        <article>
          <div class="interface-heading"><h3>{t.interfaces.extension}</h3><span class="label muted">{t.interfaces.query}</span></div>
          <CodeBlock locale={locale} code={extension} label="SQLite" />
          <a class="text-link" href={`${docs}/extension.md`}>{t.interfaces.extensionDocs} <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <div class="technical-note"><span class="label">{t.interfaces.boundaries}</span><p>{t.interfaces.note}</p></div>
    </section>
    <AgentPrompt locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .hero { padding-block: clamp(3rem, 6vw, 5rem) 4rem; }
  .hero-heading { max-width: 900px; margin-inline: auto; text-align: center; }
  .hero-eyebrow { color: var(--accent); letter-spacing: 0.22em; }
  h1 { margin-top: 1.25rem; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.08; letter-spacing: -0.035em; }
  h1 span { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.14em; }
  h1:lang(zh-CN) { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.25; letter-spacing: -0.015em; }
  .hero-description { max-width: 660px; margin: 1.5rem auto 0; color: var(--muted); font-size: 1.125rem; line-height: 1.7; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero-demo { margin-top: 3rem; }
  .section { padding-block: clamp(4rem, 7vw, 6rem); border-top: 1px solid var(--rule); }
  .section-label { color: var(--accent); margin-bottom: 1rem; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; }
  h2:lang(zh-CN) { font-size: clamp(1.9rem, 3.6vw, 2.75rem); line-height: 1.4; letter-spacing: -0.015em; }
  .section-description { max-width: 46ch; color: var(--muted); font-size: 1.0625rem; line-height: 1.8; }
  .model { display: grid; gap: 2.5rem; }
  .model .section-description { margin-top: 1.5rem; }
  .model-details > div { padding-block: 1.5rem; border-bottom: 1px solid var(--rule); }
  .model-details > div:first-child { padding-top: 0; }
  .model-details dt { font-size: 1.0625rem; font-weight: 500; }
  .model-details dd { margin-top: 0.5rem; max-width: 54ch; color: var(--muted); font-size: 0.9375rem; line-height: 1.8; }
  .section-heading { max-width: 760px; margin: 0 auto 3rem; text-align: center; }
  .section-heading .section-description { max-width: 60ch; margin: 1.5rem auto 0; }
  .interface-grid { display: grid; gap: 2.5rem; }
  .interface-grid article { min-width: 0; }
  .interface-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 1rem; }
  .interface-heading h3 { font-size: 1rem; }
  .interface-heading .label { font-size: 0.625rem; }
  .interface-grid .text-link { margin-top: 0.75rem; }
  .technical-note { display: grid; gap: 0.75rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); color: var(--muted); }
  .technical-note p { max-width: 100ch; font-size: 0.8125rem; line-height: 1.8; }
  @media (min-width: 880px) { .model { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5rem; } .interface-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; } .technical-note { grid-template-columns: 10rem 1fr; gap: 2rem; } }
  @media (max-width: 560px) { .hero-description { font-size: 1rem; } .hero-demo { margin-top: 2rem; } }
</style>
