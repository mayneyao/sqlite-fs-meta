---
import { agentPrompts } from '../data/agent';
import { messages, type Locale } from '../data/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = messages[locale].agent;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section class="agent-section container" id="agents" aria-labelledby="agent-title">
  <div class="agent-heading">
    <p class="label">{t.eyebrow}</p>
    <h2 id="agent-title">{t.title[0]}<br />{t.title[1]}</h2>
    <p class="description">{t.description}</p>
  </div>
  <div class="prompt-panel">
    <div class="prompt-toolbar">
      <span class="label">{t.promptLabel}</span>
      <button type="button" class="copy-button" data-agent-copy data-copy={agentPrompts[locale]} aria-label={t.copyLabel}>{t.copy}</button>
    </div>
    <details data-agent-details>
      <summary>{t.preview}</summary>
      <pre tabindex="0" aria-label={t.promptLabel} data-agent-prompt>{agentPrompts[locale]}</pre>
    </details>
  </div>
  <nav class="agent-docs" aria-label={t.docsLabel}>
    <a href={`${base}llms.txt`}>llms.txt <span aria-hidden="true">↗</span></a>
    <a href={`${base}docs/agent-guide.md`}>{t.guide} <span aria-hidden="true">↗</span></a>
    <a href={`${base}llms-full.txt`}>{t.full} <span aria-hidden="true">↗</span></a>
  </nav>
</section>

<style>
  .agent-section { padding-block: clamp(4rem, 7vw, 6rem); border-top: 1px solid var(--rule); }
  .agent-heading { max-width: 720px; margin-inline: auto; text-align: center; }
  .agent-heading > .label { color: var(--accent); }
  h2 { margin-top: 1rem; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; }
  h2:lang(zh-CN) { font-size: clamp(1.9rem, 3.6vw, 2.75rem); line-height: 1.4; letter-spacing: -0.015em; }
  .description { max-width: 58ch; margin: 1.5rem auto 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.8; }
  .prompt-panel { max-width: 760px; margin: 2rem auto 0; overflow: clip; border: 1px solid var(--rule-strong); border-radius: 4px; }
  .prompt-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 52px; padding-inline: 1rem 0.5rem; background: var(--wash); }
  .prompt-toolbar > .label { color: var(--muted); font-size: 0.625rem; }
  summary { padding: 0.9rem 1rem; color: var(--muted); font-size: 0.875rem; cursor: pointer; border-top: 1px solid var(--rule); }
  summary:hover { color: var(--accent); }
  summary:focus-visible { outline-offset: -4px; }
  pre { max-height: 26rem; margin: 0; padding: 0.25rem 1rem 1.25rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--sans); font-size: 0.875rem; line-height: 1.8; }
  pre:focus-visible { outline-offset: -4px; }
  .agent-docs { display: flex; justify-content: center; flex-wrap: wrap; gap: 0 1.5rem; max-width: 760px; margin: 1rem auto 0; }
  .agent-docs a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; color: var(--muted); font-size: 0.8125rem; text-decoration: none; }
  .agent-docs a:hover { color: var(--accent); text-decoration: underline; }
</style>
