---
import { messages, type Locale } from '../data/i18n';
interface Props { code: string; label?: string; locale: Locale; }
const { code, locale } = Astro.props;
const t = messages[locale];
const label = Astro.props.label ?? t.copy.example;
const text = code.trim();
---
<figure class="code-block">
  <figcaption><span class="label">{label}</span><button class="copy-button" type="button" data-copy={text} aria-label={t.copy.label(label)}>{t.copy.button}</button></figcaption>
  <pre tabindex="0" aria-label={t.copy.codeLabel(label)}><code>{text}</code></pre>
</figure>
<style>
  .code-block { min-width: 0; overflow: clip; border: 1px solid var(--terminal-line); border-radius: 4px; background: var(--terminal); color: var(--inverse); }
  figcaption { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding-inline: 1.25rem 0.6rem; border-bottom: 1px solid var(--terminal-line); color: var(--inverse-muted); }
  pre { margin: 0; min-height: 300px; padding: 1.5rem 1.25rem 2rem; overflow-x: auto; font-size: 0.75rem; line-height: 1.9; tab-size: 2; }
  .copy-button:hover { color: #b3a8f2; }
  :focus-visible { outline-color: #b3a8f2; }
  code { font-size: inherit; }
</style>
